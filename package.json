{
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-glsl": "^0.3.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.2",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/global.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "name": "@kuncat/avoidant",
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kuncat/avoidant"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "wasm-pack build crates/game --target web --out-dir ../../src/lib/wasm --out-name avoidant_wasm && rm -f src/lib/wasm/.gitignore",
    "build:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --no-emit-git-ignore --no-emit-prettier-ignore --no-emit-readme",
    "build:package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepack": "npm run build:wasm && npm run build:paraglide && npm run build:package",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "version": "0.2.3"
}
